\NeedsTeXFormat{LaTeX2e}
\ProvidesExplPackage{aaaat}{2026-09-27}{0.4.0}{AAAAT portable document package}

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[english]{babel}

\ExplSyntaxOn

\tl_new:N \g_aaaat_document_kind_tl
\tl_new:N \g_aaaat_document_title_tl
\seq_new:N \g_aaaat_metadata_seq
\seq_new:N \g_aaaat_paragraph_seq
\seq_new:N \g_aaaat_blocks_seq
\int_new:N \l_aaaat_rail_block_count_int
\int_new:N \l_aaaat_main_block_count_int
\box_new:N \l_aaaat_header_box
\box_new:N \l_aaaat_rail_body_box
\box_new:N \l_aaaat_main_body_box
\box_new:N \l_aaaat_rail_page_box
\box_new:N \l_aaaat_main_page_box
\dim_new:N \l_aaaat_region_page_height_dim
\bool_new:N \l_aaaat_header_pending_bool

\NewDocumentCommand{\AAAATDocumentKind}{m}
  {\tl_gset:Nn \g_aaaat_document_kind_tl {#1}}

\NewDocumentCommand{\AAAATIfDocumentKindTF}{mmm}
  {\tl_if_eq:NnTF \g_aaaat_document_kind_tl {#1} {#2} {#3}}

\NewDocumentCommand{\AAAATDocumentLanguage}{m}
  {
    \babelprovide[import]{#1}
    \AtBeginDocument{\selectlanguage{#1}}
  }

\NewDocumentCommand{\AAAATLineBreak}{}
  {\\}

\NewDocumentCommand{\AAAATDocumentTitle}{m}
  {\tl_gset:Nn \g_aaaat_document_title_tl {#1}}

\NewDocumentCommand{\AAAATMetadata}{mm}
  {
    \seq_gput_right:Nn \g_aaaat_metadata_seq
      {\aaaat_metadata_render:nn {#1} {#2}}
  }

\NewDocumentCommand{\AAAATParagraph}{m}
  {
    \seq_gput_right:Nn \g_aaaat_paragraph_seq
      {\aaaat_paragraph_render:n {#1}}
  }

\NewDocumentCommand{\AAAATBlock}{mm}
  {
    \seq_gput_right:Nn \g_aaaat_blocks_seq
      {\aaaat_block_render:nn {#1} {#2}}
  }

\NewDocumentCommand{\AAAATEntry}{mmmmm}
  {
    \par\medskip\noindent
    {\bfseries #1}
    \tl_if_blank:nF {#3}
      {\hfill{\small #3}}
    \par
    \tl_if_blank:nF {#2}
      {{\small\itshape #2}\par}
    \tl_if_blank:nF {#4}
      {#4\par}
    \tl_if_blank:nF {#5}
      {{\footnotesize\ttfamily #5}\par}
  }

\cs_new_protected:Npn \aaaat_document_title_render:
  {
    \tl_if_empty:NF \g_aaaat_document_title_tl
      {
        \par
        {\LARGE\bfseries \tl_use:N \g_aaaat_document_title_tl \par}
        \vspace{0.35em}
        \hrule height 0.8pt
        \vspace{0.8em}
      }
  }

\cs_new_protected:Npn \aaaat_metadata_render:nn #1#2
  {
    \par\noindent
    {\small\bfseries #1:}\nobreakspace{\small #2}
    \par
  }

\cs_new_protected:Npn \aaaat_paragraph_render:n #1
  {
    \par\noindent
    #1
    \par
  }

\cs_new_protected:Npn \aaaat_block_render:nn #1#2
  {
    \par\noindent
    {\large\bfseries #1\par}
    \vspace{0.2em}
    \hrule height 0.35pt
    \vspace{0.45em}
    #2
  }

\cs_new_protected:Npn \aaaat_set_block_split:
  {
    \int_set:Nn \l_aaaat_rail_block_count_int
      {\int_div_truncate:nn {\seq_count:N \g_aaaat_blocks_seq} {3}}
    \int_compare:nNnTF {\seq_count:N \g_aaaat_blocks_seq} < {2}
      {\int_zero:N \l_aaaat_rail_block_count_int}
      {
        \int_compare:nNnT {\l_aaaat_rail_block_count_int} < {1}
          {\int_set:Nn \l_aaaat_rail_block_count_int {1}}
      }
    \int_set:Nn \l_aaaat_main_block_count_int
      {\seq_count:N \g_aaaat_blocks_seq - \l_aaaat_rail_block_count_int}
  }

\cs_new_protected:Npn \aaaat_prepare_two_region_body:nn #1#2
  {
    \setbox\l_aaaat_rail_body_box=\vbox
      {
        \hsize=0.28\textwidth
        \parindent=0pt
        \small
        #1
        \par
      }
    \setbox\l_aaaat_main_body_box=\vbox
      {
        \hsize=0.66\textwidth
        \parindent=0pt
        #2
        \par
      }
  }

\cs_new_protected:Npn \aaaat_set_region_page_height:
  {
    \dim_set:Nn \l_aaaat_region_page_height_dim {\textheight}
    \bool_if:NT \l_aaaat_header_pending_bool
      {
        \dim_sub:Nn \l_aaaat_region_page_height_dim
          {\box_ht:N \l_aaaat_header_box + \box_dp:N \l_aaaat_header_box}
      }
  }

\cs_new_protected:Npn \aaaat_split_region_page:
  {
    \setbox\l_aaaat_rail_page_box=
      \vsplit\l_aaaat_rail_body_box to \l_aaaat_region_page_height_dim
    \setbox\l_aaaat_main_page_box=
      \vsplit\l_aaaat_main_body_box to \l_aaaat_region_page_height_dim
  }

\cs_new_protected:Npn \aaaat_render_region_row:
  {
    \hbox to \textwidth
      {
        \hbox to 0.28\textwidth
          {
            \vbox to \l_aaaat_region_page_height_dim
              {\box\l_aaaat_rail_page_box\vfil}
            \hss
          }
        \hfil
        {\vrule width 0.45pt height \l_aaaat_region_page_height_dim depth 0pt}
        \hfil
        \hbox to 0.66\textwidth
          {
            \vbox to \l_aaaat_region_page_height_dim
              {\box\l_aaaat_main_page_box\vfil}
            \hss
          }
      }
  }

\cs_new_protected:Npn \aaaat_render_two_region_page:
  {
    \aaaat_set_region_page_height:
    \aaaat_split_region_page:
    \par
    \nointerlineskip
    \vbox to \textheight
      {
        \bool_if:NT \l_aaaat_header_pending_bool
          {
            \box\l_aaaat_header_box
            \nointerlineskip
          }
        \aaaat_render_region_row:
      }
    \par
    \bool_set_false:N \l_aaaat_header_pending_bool
    \ifvoid\l_aaaat_rail_body_box
      \ifvoid\l_aaaat_main_body_box
      \else
        \newpage
        \aaaat_render_two_region_page:
      \fi
    \else
      \newpage
      \aaaat_render_two_region_page:
    \fi
  }

\NewDocumentCommand{\AAAATRenderDocumentTitle}{}
  {\aaaat_document_title_render:}

\NewDocumentCommand{\AAAATFullWidthHeader}{m}
  {
    \setbox\l_aaaat_header_box=\vbox
      {
        \hsize=\textwidth
        \parindent=0pt
        #1
        \par
        \vspace{0.8em}
      }
    \bool_set_true:N \l_aaaat_header_pending_bool
  }

\NewDocumentCommand{\AAAATTwoRegionBody}{mm}
  {
    \begingroup
    \splittopskip=0pt
    \splitmaxdepth=0pt
    \aaaat_prepare_two_region_body:nn {#1} {#2}
    \aaaat_render_two_region_page:
    \endgroup
  }

\NewDocumentCommand{\AAAATRenderRailBlocks}{}
  {
    \aaaat_set_block_split:
    \seq_map_indexed_inline:Nn \g_aaaat_blocks_seq
      {
        \int_compare:nNnT {##1} > {\l_aaaat_main_block_count_int}
          {
            ##2
            \int_compare:nNnT {##1} < {\seq_count:N \g_aaaat_blocks_seq}
              {\par\medskip}
          }
      }
  }

\NewDocumentCommand{\AAAATRenderMainBlocks}{}
  {
    \aaaat_set_block_split:
    \seq_map_indexed_inline:Nn \g_aaaat_blocks_seq
      {
        \int_compare:nNnF {##1} > {\l_aaaat_main_block_count_int}
          {
            ##2
            \int_compare:nNnT {##1} < {\l_aaaat_main_block_count_int}
              {\par\medskip}
          }
      }
  }

\NewDocumentCommand{\AAAATRenderLetter}{}
  {
    \aaaat_document_title_render:
    \seq_map_inline:Nn \g_aaaat_metadata_seq {##1}
    \vspace{0.8em}
    \seq_map_inline:Nn \g_aaaat_paragraph_seq {##1}
  }

\ExplSyntaxOff
